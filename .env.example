# Postgres connection string (Neon, Supabase, or local Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session cookie signing key (self-rolled email/password auth — see
# src/lib/session.ts). Generate your own:
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET=""
