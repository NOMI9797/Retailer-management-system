generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy ──────────────────────────────────────────────

model Shop {
  id                String   @id @default(uuid())
  name              String
  createdAt         DateTime @default(now())

  areas               Area[]
  customers           Customer[]
  dealers             Dealer[]
  accountTypes        AccountType[]
  categories          Category[]
  units               Unit[]
  products            Product[]
  dailySales          DailySale[]
  expenses            Expense[]
  monthlyExpenseTypes MonthlyExpenseType[]
  cashRegisters       DailyCashRegister[]
  bankAccounts        BankAccount[]
}

// Shopkeeper-managed list of real bank accounts (UBL, Meezan, ...) —
// same shape as Category/Unit (a name the shopkeeper maintains), plus
// a stored running balance. currentBalance is updated in the same
// transaction as every write that references this account via
// bankAccountId (mirrors CustomerAccount.currentBalance's pattern)
// rather than computed live, since it's read far more often than
// written. A write that would take the balance negative is rejected
// outright (see bankAccounts.actions.ts: postToBankAccount) — every
// ACCOUNT row recorded before this feature existed has no
// bankAccountId and is never backfilled (see the bankAccountId
// comment on each model below), so the column itself stays capable of
// holding a stale negative balance from that history, even though no
// NEW write can ever push it there.
model BankAccount {
  id             String  @id @default(uuid())
  shopId         String
  shop           Shop    @relation(fields: [shopId], references: [id])
  name           String
  isActive       Boolean @default(true)
  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  accountTransactions    AccountTransaction[]
  dailySalePayments      DailySalePayment[]
  grainSaleCreditPayments GrainSaleCreditPayment[]
  expenses               Expense[]
  expensePayments        ExpensePayment[]
  dealerTransactions     DealerTransaction[]
  dealerProductPurchases DealerProductPurchase[]

  @@unique([shopId, name])
}

model Area {
  id           String  @id @default(uuid())
  shopId       String
  shop         Shop    @relation(fields: [shopId], references: [id])
  name         String
  parentAreaId String?
  parentArea   Area?   @relation("AreaHierarchy", fields: [parentAreaId], references: [id])
  subAreas     Area[]  @relation("AreaHierarchy")

  customers Customer[]
}

// ── Customer ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  name      String
  phone     String?
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  accounts     CustomerAccount[]
  dailySales   DailySale[]
  ownedBatches GrainBatch[]
  stockUdhaars StockUdhaarEntry[]
}

// ── Dealer ───────────────────────────────────────────────
// A bulk supplier/buyer the shop does business with — deliberately a
// FULLY SEPARATE entity from Customer, not a flagged Customer row, so
// "who owes the shop" (customers) and "who the shop buys bulk stock
// from / sells bulk stock to" (dealers) never bleed into each other's
// pickers, lists, or reports. A dealer never appears in a Customer
// search and vice versa.
enum DealerType {
  PRODUCTS
  GRAIN
}

model Dealer {
  id        String     @id @default(uuid())
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id])
  name      String
  phone     String?
  // Which side of the business this dealer supplies — PRODUCTS (bulk
  // Simple-stock merchandise, see DealerProductPurchase) or GRAIN
  // (grain batches, see GrainBatch.dealerId). A dealer is one or the
  // other, never both, same "a category is one stock kind, never
  // shared" decision Category.stockKind already established — keeps
  // the Dealer picker on each purchase/sale flow offering only
  // dealers that actually make sense there.
  type      DealerType
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  account   DealerAccount?
  purchases DealerProductPurchase[]
  batches   GrainBatch[]
  dailySales DailySale[]

  @@unique([shopId, name])
}

// One running Udhaar balance per dealer — same shape as
// CustomerAccount, minus the account-type/custom-field machinery
// (a dealer has exactly one account, never several kinds). Sign
// convention is the MIRROR of CustomerAccount: positive currentBalance
// means the SHOP owes the DEALER (the shop is the buyer in most
// dealer activity — Product/Grain purchases on Credit — so "the shop
// owes" is the natural default direction here, the same way
// isShopBorrowed inverts the usual OUT/IN meaning on
// AccountTransaction for the shop-borrows-from-customer case).
// Negative means the dealer owes the shop instead (e.g. the shop sold
// bulk stock TO this dealer on Credit — see DailySale.dealerId).
model DealerAccount {
  id             String  @id @default(uuid())
  dealerId       String  @unique
  dealer         Dealer  @relation(fields: [dealerId], references: [id])
  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  transactions DealerTransaction[]
}

// A posting against a dealer's Udhaar balance — same shape as
// AccountTransaction, scoped to DealerAccount instead of
// CustomerAccount. direction OUT = the shop's debt to the dealer
// grows (a Credit purchase from them); IN = the shop pays that debt
// down. When the shop instead SELLS to a dealer on Credit (via
// DailySale.dealerId), the meaning inverts the same way
// isShopBorrowed does elsewhere: that posting's OUT means the DEALER
// now owes the shop more, tracked via the isDealerSale flag below so
// a mixed "dealer I buy from AND occasionally sell to" relationship
// never nets the two activities together into one misleading number.
model DealerTransaction {
  id              String          @id @default(uuid())
  dealerAccountId String
  dealerAccount   DealerAccount   @relation(fields: [dealerAccountId], references: [id])
  transactionDate DateTime        @default(now())
  direction       TxnDirection
  amount          Decimal         @db.Decimal(14, 2)
  // Set only by a dealer product purchase (DealerProductPurchase) paid
  // on Credit — mirrors AccountTransaction.linkedGrainBatchId's
  // "real 1:1 link to the thing this posting paid for" pattern.
  linkedPurchaseId String?
  linkedPurchase   DealerProductPurchase? @relation(fields: [linkedPurchaseId], references: [id])
  // Set only when this posting came from the shop SELLING to this
  // dealer (DailySale.dealerId) rather than buying from them — see
  // this model's own comment on why the OUT/IN meaning inverts here,
  // same "isShopBorrowed" precedent.
  isDealerSale    Boolean         @default(false)
  linkedSaleId    String?
  linkedSale      DailySale?      @relation(fields: [linkedSaleId], references: [id])
  // true = a Cash/Account dealer purchase, posted purely so Cash Flow
  // (and any other report) has a real row to read for "money left the
  // shop today" — never touches DealerAccount.currentBalance, unlike
  // every other row here (a Credit purchase growing the debt, or a
  // repayment paying it down). Before this flag existed, a Cash/
  // Account dealer purchase created NO record anywhere that money had
  // left the shop — see getDealer's totalPaid comment for why that was
  // never a problem for the debt math (it derives totalPaid from
  // totalPurchased - outstanding, never from this transaction log),
  // but it was a real gap for cash accounting specifically.
  isSettledPurchase Boolean       @default(false)
  paymentMethod   PaymentMethod
  // Same convention as AccountTransaction.bankAccountId — set only
  // when paymentMethod = ACCOUNT.
  bankAccountId   String?
  bankAccount     BankAccount?    @relation(fields: [bankAccountId], references: [id])
  notes           String?
}

// One bulk purchase of Simple (non-grain) stock from a PRODUCTS-type
// dealer — Dealer (Shop Purchases)'s own record. Unlike GrainBatch,
// Simple stock has no per-batch cost tracking today (Product.quantity/
// costPrice are single blended figures — see Product's own schema
// comment), so this purchase bumps Product.quantity and overwrites
// Product.costPrice to the latest cost, per the explicit "keep it
// simple" decision, while still keeping its OWN historical cost here
// for this purchase's own Udhaar/stats accuracy even after a later
// purchase changes the product's live costPrice.
model DealerProductPurchase {
  id            String        @id @default(uuid())
  dealerId      String
  dealer        Dealer        @relation(fields: [dealerId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  quantity      Decimal       @db.Decimal(14, 3)
  costPrice     Decimal       @db.Decimal(12, 2)
  purchaseDate  DateTime      @default(now())
  paymentMethod PaymentMethod
  // Same convention as AccountTransaction.bankAccountId — set only
  // when paymentMethod = ACCOUNT.
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  notes         String?

  dealerTransactions DealerTransaction[]
}

// ── Settings-managed: account types & their custom fields ──

enum AccountFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
}

enum AccountStatus {
  ACTIVE
  CLOSED
}

model AccountType {
  id             String  @id @default(uuid())
  shopId         String
  shop           Shop    @relation(fields: [shopId], references: [id])
  name           String
  code           String
  // Marks a type as a deliberate loan (e.g. Udhar) rather than a
  // normal running tab (Regular). Explicit and shopkeeper-controlled
  // rather than inferred from `code` or `name`, since both are free
  // text the shopkeeper can set to anything (a shop's "Udhar" type has
  // been seen coded "123"). Powers the Debt module's "Loan" vs
  // "On account" badge.
  isLoan         Boolean @default(false)
  isActive       Boolean @default(true)

  fields           AccountTypeField[]
  customerAccounts CustomerAccount[]

  @@unique([shopId, code])
}

model AccountTypeField {
  id            String           @id @default(uuid())
  accountTypeId String
  accountType   AccountType      @relation(fields: [accountTypeId], references: [id])
  fieldName     String
  fieldLabel    String
  fieldType     AccountFieldType
  isRequired    Boolean          @default(false)
  displayOrder  Int              @default(0)

  values AccountFieldValue[]
}

model CustomerAccount {
  id             String        @id @default(uuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  accountTypeId  String
  accountType    AccountType   @relation(fields: [accountTypeId], references: [id])
  openedDate     DateTime      @default(now())
  status         AccountStatus @default(ACTIVE)
  currentBalance Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?

  fieldValues  AccountFieldValue[]
  transactions AccountTransaction[]
}

model AccountFieldValue {
  id                 String           @id @default(uuid())
  customerAccountId  String
  customerAccount    CustomerAccount  @relation(fields: [customerAccountId], references: [id])
  accountTypeFieldId String
  accountTypeField   AccountTypeField @relation(fields: [accountTypeFieldId], references: [id])
  value              String
}

// ── Ledger ───────────────────────────────────────────────

enum TxnDirection {
  IN
  OUT
}

// How money moved for a given posting — CASH (physical cash, paid
// now), ACCOUNT (bank/online transfer, also paid now, just a
// different channel), or CREDIT (not paid yet — this is the only one
// that ever creates an outstanding balance). Cash and Account are
// both "settled immediately"; they're tracked separately so Cash Flow
// (Milestone 3) can reconcile the physical cash drawer against bank
// movement, not because either one is owed.
enum PaymentMethod {
  CASH
  ACCOUNT
  CREDIT
}

model AccountTransaction {
  id                String          @id @default(uuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  transactionDate   DateTime        @default(now())
  direction         TxnDirection
  amount            Decimal         @db.Decimal(14, 2)
  quantity          Decimal?        @db.Decimal(14, 3)
  linkedSaleId      String?
  linkedSale        DailySale?      @relation(fields: [linkedSaleId], references: [id])
  // Set only by payCustomerForGrain (stock/actions.ts), on the SAME
  // call that creates the new shop-owned GrainBatch this transaction
  // paid for — a real 1:1 link, since one transfer-purchase/settle-now
  // call creates exactly one of each. Lets a per-settlement view (the
  // customer's Grain tab) show that specific purchase's own paid/
  // Udhaar status and exact date, rather than only an aggregate figure
  // across every settlement on the account.
  linkedGrainBatchId String?
  linkedGrainBatch  GrainBatch?     @relation(fields: [linkedGrainBatchId], references: [id])
  // Set only by payGrainDebt (stock/actions.ts) — which PRODUCT this
  // payment clears the shop's grain debt for. A payGrainDebt payment
  // is a pure money posting with no grain batch of its own (unlike
  // linkedGrainBatchId above, set on the OUT side when the debt was
  // first created), so product attribution has to be carried
  // explicitly here instead of inferred through a batch. Lets
  // getShopOwedForGrain report a genuinely product-scoped "money
  // owed" figure — paying down Cotton debt must never appear to also
  // reduce Wheat debt — per the "pay per product, from that product's
  // own row" decision: every payGrainDebt call is now scoped to one
  // product, never a combined cross-product lump sum.
  linkedProductId   String?
  linkedProduct     Product?        @relation(fields: [linkedProductId], references: [id])
  paymentMethod     PaymentMethod
  // Only ever set on a loan-given posting (direction OUT on an
  // Udhar/Regular account) — optional, since not every loan needs a
  // formal due date. Powers the Debt module's
  // overdue flag: an account counts as overdue when its OLDEST unpaid
  // transaction's dueDate has passed and currentBalance is still > 0.
  // Deliberately not a full payment-allocation engine — see the
  // Debt (Udhaar) Tracking milestone for why that's out of scope.
  dueDate           DateTime?
  // Marks this posting as belonging to a Long-term Udhaar loan (a
  // deliberate cash loan with a chosen duration, e.g. "3 months") as
  // opposed to Regular/Daily Udhaar (which accrues naturally from
  // Credit sales, no fixed term). Both kinds share the same
  // CustomerAccount/currentBalance — this flag is what lets the
  // Udhaar page's two tabs compute isolated borrowed/paid/remaining
  // totals for each kind separately, since they aren't otherwise
  // distinguishable once posted. Defaults false for every existing
  // and Regular Udhaar transaction; only the Long-term Udhaar form
  // sets it true. A repayment against a long-term loan must also be
  // tagged true by whoever records it — there's no automatic way to
  // tell which "bucket" a repayment is clearing.
  isLongTerm        Boolean         @default(false)
  // Marks this posting as belonging to the Shop (Udhaar) bucket — cash
  // the SHOP itself borrows from a customer (e.g. asking a customer
  // for Rs 50,000 to cover a shortfall), the mirror direction from
  // every other bucket on this table. Deliberately isolated from
  // currentBalance (see createShopBorrowedLoan/payShopBorrowedLoan in
  // stock... customers/actions.ts) rather than sharing it the way
  // isLongTerm does — mixing "customer owes shop" and "shop owes
  // customer" into one balance would silently net them together,
  // which the "separate dedicated bucket, never combined" decision
  // explicitly rules out. direction OUT = shop borrows (shop owes
  // more), IN = shop repays — opposite meaning from every other
  // bucket's OUT/IN, but scoped entirely to isShopBorrowed rows, so it
  // never collides with the Udhaar convention elsewhere on this table.
  isShopBorrowed    Boolean         @default(false)
  // Which real bank account this posting moved money through — only
  // ever set when paymentMethod = ACCOUNT, null for CASH/CREDIT rows
  // and for every ACCOUNT row recorded before the Bank Accounts
  // feature existed (deliberately left unassigned rather than
  // backfilled to a guessed account — see BankAccount's schema
  // comment). Required at the Zod/action layer going forward whenever
  // paymentMethod is ACCOUNT, even though the column itself stays
  // nullable to accommodate that historical data.
  bankAccountId     String?
  bankAccount       BankAccount?    @relation(fields: [bankAccountId], references: [id])
  notes             String?
}

// ── Products & stock ─────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id])
  name      String
  isActive  Boolean   @default(true)
  // Which kind of product this category is for — Simple stock
  // (general merchandise) or Grain stock. A category is one or the
  // other, never shared: this is what lets Settings show two real
  // sections (Product / Grain) and the product-form category
  // dropdown offer only the kind matching whichever stockKind toggle
  // is active, instead of one flat list a shopkeeper could file a
  // grain product under a merchandise category (or vice versa) by
  // mistake. Defaults SIMPLE for the migration backfill of every
  // pre-existing category except ones already holding only GRAIN
  // products.
  stockKind StockKind @default(SIMPLE)

  products Product[]

  @@unique([shopId, name])
}

// Shopkeeper-editable list (kg, packet, piece, liter, ...), reused as
// the unit dropdown on both simple and grain products — never
// hardcoded per the product document's "no hardcoded lists" principle.
model Unit {
  id       String  @id @default(uuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id])
  name     String
  isActive Boolean @default(true)

  products Product[]

  @@unique([shopId, name])
}

enum StockKind {
  SIMPLE
  GRAIN
}

model Product {
  id         String    @id @default(uuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id])
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  name       String
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id])
  stockKind  StockKind @default(SIMPLE)
  // SIMPLE stock uses costPrice/sellPrice; GRAIN stock uses baseRate as
  // a reference rate only — each GrainBatch carries its own actual
  // rate, since grain prices move during the season.
  costPrice  Decimal?  @db.Decimal(12, 2)
  sellPrice  Decimal?  @db.Decimal(12, 2)
  baseRate   Decimal?  @db.Decimal(12, 2)
  quantity   Decimal   @default(0) @db.Decimal(14, 3)
  // GRAIN only — a second, deliberately simpler money tracker
  // alongside the per-batch rate/FIFO system above (GrainBatch.rate,
  // quantitySold, etc. — untouched by this, still the source of truth
  // for Own/Customer/Total stock and Stock Udhaar). This pair treats
  // every purchase and sale of this grain as one pooled balance, per
  // explicit shopkeeper decision: no per-batch cost, no FIFO, no
  // per-sale profit — just "how much is physically in the pool" and
  // "how much of the money put into that pool hasn't been recovered
  // by sales yet." pooledStockValue is allowed to go NEGATIVE
  // internally (once sales have collected more than was ever paid in)
  // — that's the expected, normal "all investment recovered, this is
  // now profit" state, not an error; the UI never shows the raw
  // negative number, it shows the absolute value labeled "Profit"
  // instead (see getPooledGrainStock). Never resets across restocks —
  // a new purchase after a full sell-off just keeps adding onto
  // whatever pooledStockValue already is. A purchase only ever
  // increments both fields when it has a REAL rate — a customer's
  // rate-less "store for later" deposit doesn't touch this pool at
  // all until it's actually priced (at settlement, or a sale-time
  // rate override), same "never guessed, never zero" rule the
  // existing per-batch COGS system already follows.
  pooledStockQuantity Decimal @default(0) @db.Decimal(14, 3)
  pooledStockValue    Decimal @default(0) @db.Decimal(14, 2)

  batches            GrainBatch[]
  saleItems          DailySaleItem[]
  stockUdhaars       StockUdhaarEntry[]
  grainDebtPayments  AccountTransaction[]
  dealerPurchases    DealerProductPurchase[]
}

// Batches let one product (e.g. "Wheat") hold both shop-owned and
// customer-deposited stock at once. ownerCustomerId = null means
// shop-owned. A customer batch represents stock deposited for
// safekeeping, not a consignment sale — no money posts when one is
// created (see Stock Management: createGrainBatch).
model GrainBatch {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  ownerCustomerId String?
  ownerCustomer   Customer? @relation(fields: [ownerCustomerId], references: [id])
  // A grain batch's source is EITHER a depositing customer
  // (ownerCustomerId, the existing "stored for safekeeping" flow) OR a
  // GRAIN-type dealer bought from in bulk — never both. A dealer batch
  // is always shop-owned from the moment it's created (there's no
  // "dealer deposits for later, shop settles afterward" concept the
  // way a customer deposit has — a dealer purchase is a real,
  // immediate buy with its own agreed rate), so it flows through the
  // exact same FIFO/sale machinery every shop-owned batch already
  // uses, just tagged with where it came from.
  dealerId        String?
  dealer          Dealer?   @relation(fields: [dealerId], references: [id])
  quantityIn      Decimal   @db.Decimal(14, 3)
  quantitySold    Decimal   @default(0) @db.Decimal(14, 3)
  // Only meaningful when ownerCustomerId is set. Tracks how much of
  // this customer batch's OWNERSHIP CLAIM has been settled away via a
  // transfer-purchase (createTransferPurchase) — deliberately separate
  // from quantitySold, which tracks PHYSICAL depletion via an ordinary
  // sale regardless of settlement. A sale that draws on a customer
  // batch before it's been purchased from them (Stock Udhaar) must
  // decrement physical availability WITHOUT reducing the customer's
  // claim — see StockUdhaarEntry. The customer's remaining ownership
  // claim is quantityIn - quantityTransferred (never quantityIn -
  // quantitySold). Always 0 for shop-owned batches.
  quantityTransferred Decimal @default(0) @db.Decimal(14, 3)
  // Null means "not yet priced" — either a customer's store-for-later
  // deposit awaiting settlement (createGrainBatch with no rate given),
  // or grain sold via Stock Udhaar before its sale-time cost rate was
  // captured (see applySaleItems' MissingBatchRateError). Always set
  // for a shop-owned batch, whether from an ordinary deposit, a
  // transfer-purchase, or a settle-now deposit — a shop-owned batch is
  // the shop's actual inventory and must always have a real cost
  // basis. Once set, never reverts to null.
  rate            Decimal?  @db.Decimal(12, 2)
  receivedAt      DateTime  @default(now())
  // Set only on a shop-owned batch created BY a transfer-purchase,
  // pointing at the customer batch it drew its claim from. Pure
  // audit/traceability — never read for quantity or cost math, since
  // this new batch's own `rate` (the agreed purchase rate) is already
  // its true cost basis for later profit calculation.
  sourceBatchId   String?
  sourceBatch     GrainBatch? @relation("BatchTransferSource", fields: [sourceBatchId], references: [id])
  transferredBatches GrainBatch[] @relation("BatchTransferSource")

  saleAllocations DailySaleItemBatch[]
  stockUdhaars    StockUdhaarEntry[]
  // The payment transaction(s) linked to THIS batch via
  // AccountTransaction.linkedGrainBatchId — in practice exactly one,
  // since payCustomerForGrain creates one of each per call, but this
  // stays a list since nothing prevents more in principle.
  paymentTransactions AccountTransaction[]
}

// A signed-quantity ledger tracking a shopkeeper's outstanding stock
// obligation to a customer — grain sold from that customer's deposited
// batch to an outside buyer BEFORE the shopkeeper purchased/settled it
// from them (see applySaleItems). A real ledger, not a derived value,
// for the same reason AccountTransaction is a real ledger rather than
// a mutated balance: auditability (which sale caused this shortfall?),
// safe reversal (editing/deleting a sale must shrink exactly what it
// grew, via a compensating entry — see reverseSaleContents — never a
// silent recompute), and because the functional spec explicitly
// requires this obligation is never silently reduced. Positive
// quantity = shortfall grew (an unsettled sale); negative = shortfall
// resolved (settled by a transfer-purchase, or a sale reversal).
// Scoped per customer AND per product — a customer can deposit several
// different commodities, and a shortfall in one must never net against
// a surplus in another.
model StockUdhaarEntry {
  id                    String     @id @default(uuid())
  customerId            String
  customer              Customer   @relation(fields: [customerId], references: [id])
  productId             String
  product               Product    @relation(fields: [productId], references: [id])
  grainBatchId          String
  grainBatch            GrainBatch @relation(fields: [grainBatchId], references: [id])
  quantity              Decimal    @db.Decimal(14, 3)
  linkedSaleId          String?
  linkedSale            DailySale? @relation(fields: [linkedSaleId], references: [id])
  // Set on the settlement leg a transfer-purchase writes when it pays
  // down an outstanding shortfall — points at the new shop-owned batch
  // that purchase created, so a shortfall's resolution is traceable
  // back to the exact purchase that cleared it.
  linkedTransferBatchId String?
  createdAt             DateTime   @default(now())
  notes                 String?
}

// ── Daily sales ──────────────────────────────────────────

// A sale's counterparty is EITHER a customer OR a dealer, never both
// — customerId/dealerId are mutually exclusive, enforced at the Zod/
// action layer (a check constraint would need a CASE expression this
// migration keeps simple by relying on the app layer instead, same as
// every other "exactly one of" rule in this schema). Selling to a
// dealer (a bulk buyer) shares this exact same sale/payment-split/
// Credit-posting machinery as selling to a customer — only WHICH
// ledger a Credit portion posts against differs (DealerAccount instead
// of CustomerAccount; see applyPaymentSplit).
model DailySale {
  id         String    @id @default(uuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  dealerId   String?
  dealer     Dealer?   @relation(fields: [dealerId], references: [id])
  saleDate   DateTime  @default(now())
  season     String?

  items              DailySaleItem[]
  payments           DailySalePayment[]
  accountTxns        AccountTransaction[]
  dealerTransactions DealerTransaction[]
  stockUdhaars       StockUdhaarEntry[]
}

model DailySaleItem {
  id              String    @id @default(uuid())
  dailySaleId     String
  dailySale       DailySale @relation(fields: [dailySaleId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Decimal   @db.Decimal(14, 3)
  actualPrice     Decimal   @db.Decimal(12, 2)
  // Snapshot of Product.costPrice at the moment this sale happened —
  // only ever set for SIMPLE stock items (null for GRAIN). Without
  // this, a later change to a product's cost price would silently
  // rewrite the COGS of every past sale of that product whenever a
  // report re-reads Product.costPrice. Grain items don't need this:
  // each GrainBatch permanently records its own rate (a new batch is
  // a new row, never an edit to an old one), and DailySaleItemBatch
  // already records exactly which batch(es) a sale drew from — so
  // grain COGS is computed at report time from batch rate × quantity,
  // which is already historically accurate with no snapshot needed.
  // Null on sales recorded before this field existed — reports show
  // "cost data unavailable" for those rather than guessing, per the
  // Milestone 4 decision.
  costPriceAtSale Decimal?  @db.Decimal(12, 2)
  // How much of THIS item's own actualPrice × quantity was paid via
  // Credit — set only for GRAIN items (see dailySaleItemSchema's
  // comment on when the client supplies it: always for a single-item
  // grain sale's whole credit amount, or per-item when a sale has
  // more than one grain item). Null means "not tracked" — either a
  // SIMPLE item (Credit purchases of simple stock aren't broken out
  // per item, only per whole account, same as before this feature),
  // or a sale recorded before this field existed. This is what makes
  // "Customer Udhaar" (getCustomerGrainCreditPurchases) a real,
  // sale-recorded fact rather than a proportional guess.
  creditAmount    Decimal?  @db.Decimal(12, 2)
  // When THIS item's own creditAmount must be paid back by — set
  // alongside creditAmount, same "duration picked at entry time,
  // due date derived and stored" shape AccountTransaction.dueDate
  // uses for Long-term Udhaar/Shop-Borrowed loans. Null whenever
  // creditAmount is null, or when a shopkeeper didn't set one (not
  // every Credit purchase needs a formal due date).
  creditDueDate   DateTime? @db.Date
  // Same value for every item (and DailySalePayment row) written by
  // one createDailySale call — lets a customer's second visit on the
  // same day, which appends to the same DailySale row rather than
  // creating a new one, still be displayed as its own distinct group
  // instead of mixing in with the first visit's items.
  visitAt         DateTime  @default(now())

  batchAllocations DailySaleItemBatch[]
  creditPayments   GrainSaleCreditPayment[]
}

// One payment against a specific grain sale item's Credit amount (see
// DailySaleItem.creditAmount) — mirrors ExpensePayment/GrainBatch's
// own per-row payment pattern. Sum of `amount` across a given item's
// payments is that item's totalPaid; creditAmount - totalPaid is
// what's still owed (see daily-sales/actions.ts:
// getCustomerGrainCreditPurchases).
model GrainSaleCreditPayment {
  id              String        @id @default(uuid())
  dailySaleItemId String
  dailySaleItem   DailySaleItem @relation(fields: [dailySaleItemId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  // Same convention as AccountTransaction.bankAccountId — set only
  // when paymentMethod = ACCOUNT.
  bankAccountId   String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])
  paidAt          DateTime      @default(now())
  notes           String?
}

// The whole-sale bill total split across payment methods — e.g. a
// Rs 650 bill might be Rs 200 CASH + Rs 250 ACCOUNT + Rs 200 CREDIT,
// one row per method actually used (not one per line item — the
// split happens on the total, not per product). Only the CREDIT
// row(s) ever cause an AccountTransaction; CASH/ACCOUNT rows exist
// purely for Cash Flow reconciliation (Milestone 3).
model DailySalePayment {
  id            String        @id @default(uuid())
  dailySaleId   String
  dailySale     DailySale     @relation(fields: [dailySaleId], references: [id])
  paymentMethod PaymentMethod
  // Same convention as AccountTransaction.bankAccountId — set only
  // when paymentMethod = ACCOUNT.
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  // Matches the visitAt on the DailySaleItem rows written by the same
  // createDailySale call — see DailySaleItem.visitAt.
  visitAt       DateTime      @default(now())
}

// Depleting oldest-first can span more than one batch for a single
// sale item (e.g. batch A has 5kg left, the sale is for 20kg — 5kg
// comes from A, 15kg from B). One row per batch actually drawn from,
// so a Stock Udhaar posting (when the batch is customer-owned) can be
// traced back to the exact batch and quantity involved.
model DailySaleItemBatch {
  id              String        @id @default(uuid())
  dailySaleItemId String
  dailySaleItem   DailySaleItem @relation(fields: [dailySaleItemId], references: [id])
  grainBatchId    String
  grainBatch      GrainBatch    @relation(fields: [grainBatchId], references: [id])
  quantity        Decimal       @db.Decimal(14, 3)
}

// ── Expenses ─────────────────────────────────────────────

// DAILY expenses feed Cash Flow's daily register (see
// cash-flow/actions.ts's sumCashOut). MONTHLY expenses are recorded
// here for now but deliberately NOT wired into Cash Flow or anything
// else yet — that's future work, once Cash Flow grows a monthly-level
// view to fold them into. Until then a MONTHLY row is just tracked,
// not aggregated anywhere.
enum ExpenseType {
  DAILY
  MONTHLY
}

// Settings-managed list of recurring monthly expense categories
// (Electricity bill, AC bill, Rent, ...) — same shape as Category/Unit
// (a name the shopkeeper maintains, not hardcoded). A MONTHLY expense
// always picks one of these instead of typing free text, since the
// same handful of bills repeat every month; a DAILY expense still
// just uses Expense.description directly.
model MonthlyExpenseType {
  id       String  @id @default(uuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id])
  name     String
  isActive Boolean @default(true)

  expenses Expense[]

  @@unique([shopId, name])
}

model Expense {
  id                   String              @id @default(uuid())
  shopId               String
  shop                 Shop                @relation(fields: [shopId], references: [id])
  description          String
  amount               Decimal             @db.Decimal(12, 2)
  expenseDate          DateTime            @default(now())
  paymentMethod        PaymentMethod
  // Same convention as AccountTransaction.bankAccountId — set only
  // when paymentMethod = ACCOUNT.
  bankAccountId        String?
  bankAccount          BankAccount?        @relation(fields: [bankAccountId], references: [id])
  expenseType          ExpenseType         @default(DAILY)
  // Only set when expenseType = MONTHLY — which recurring bill this
  // entry is for. Null for DAILY expenses, which have no fixed
  // category and just use `description` freely.
  monthlyExpenseTypeId String?
  monthlyExpenseType   MonthlyExpenseType? @relation(fields: [monthlyExpenseTypeId], references: [id])

  // Only ever populated for a CREDIT expense — a running log of
  // partial/full payments made later to clear it (see
  // expenses/actions.ts: payExpenseDebt). A CASH/ACCOUNT expense is
  // paid in the same breath it's recorded and never gets one of these.
  payments ExpensePayment[]
}

// One payment against a CREDIT expense — mirrors how payGrainDebt
// tracks the shop paying down grain debt, but scoped to a single
// expense row rather than a whole customer account, since an expense
// has no customer/account of its own to post against. Sum of
// `amount` across a given expense's payments is that expense's
// totalPaid; amount - totalPaid is what's still owed (see
// expenses/actions.ts: getShopExpenseUdhaar).
model ExpensePayment {
  id            String        @id @default(uuid())
  expenseId     String
  expense       Expense       @relation(fields: [expenseId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  // Same convention as AccountTransaction.bankAccountId — set only
  // when paymentMethod = ACCOUNT.
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  paidAt        DateTime      @default(now())
  notes         String?
}

// ── Cash flow / daily register ────────────────────────────

// One row per shop per day. openingBalance is either the shopkeeper's
// one-time manual entry (day one) or copied forward from the prior
// day's actualClosing when the register is opened for a new day.
// expectedClosing is recorded at day-close time as a snapshot of
// openingBalance + that day's cash in − cash out — a snapshot rather
// than always-recomputed, since past days' cash sales/expenses could
// later be edited and a closed day's expected figure shouldn't retroactively
// shift after the shopkeeper has already reconciled and closed it.
// variance is NOT stored — it's just expectedClosing − actualClosing,
// trivially derived, so there's nothing to drift out of sync if either
// value is ever corrected.
model DailyCashRegister {
  id                     String    @id @default(uuid())
  shopId                 String
  shop                   Shop      @relation(fields: [shopId], references: [id])
  date                   DateTime
  openingBalance         Decimal   @db.Decimal(14, 2)
  expectedClosing        Decimal   @db.Decimal(14, 2)
  actualClosing          Decimal?  @db.Decimal(14, 2)
  closedAt               DateTime?
  // True only when a shopkeeper explicitly typed this day's opening
  // balance (via setOpeningBalance/editOpeningBalance) rather than it
  // being carried forward from the prior day's actualClosing. Acts as
  // a firewall for the forward-cascade when a closing balance is
  // edited: the cascade recomputes each following day's derived
  // opening/expected/variance until it reaches a day where this flag
  // is true, since a manual entry always wins over whatever an
  // earlier day's closing implies.
  openingBalanceIsManual Boolean   @default(false)

  @@unique([shopId, date])
}
